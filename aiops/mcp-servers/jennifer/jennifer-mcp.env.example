# 복사해서 aiops/config/jennifer-mcp.env 로 사용 (root:root 600, git·백업 제외)
# false 이면 모든 도구가 "어댑터 비활성"을 돌려줍니다. 차단 규칙 테스트와 샘플 확인 후 true로 바꿉니다 (설계 13.6).
JENNIFER_MCP_ENABLED=false
JENNIFER_TOKEN_INTERNET=
JENNIFER_TOKEN_ADMIN=
JENNIFER_TOKEN_PUBLIC=
# MCP 서버 자체 인증 (API·Open WebUI가 이 값으로 Bearer 호출). 06-init-secrets.sh가 자동 생성
MCP_AUTH_TOKEN=
# 응답 크기 제한 (LLM 컨텍스트 보호)
JENNIFER_MAX_ITEMS=200
JENNIFER_MAX_BYTES=2000000
