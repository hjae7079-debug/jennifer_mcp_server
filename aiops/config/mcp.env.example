# (v0.3.3) Jennifer MCP 는 compose 서비스(jennifer-mcp)로 실행합니다.
# 호스트에서 127.0.0.1:8791 로 띄우면 컨테이너(host.docker.internal)에서 접근할 수 없습니다.
# API용 값은 .env 에 넣습니다:
#   JENNIFER_MCP_URL=http://jennifer-mcp:8791/mcp
#   JENNIFER_MCP_TOKEN=<06-init-secrets.sh 가 생성>
# Jennifer 뷰서버 토큰은 config/jennifer-mcp.env 에 넣습니다 (mcp-servers/jennifer/jennifer-mcp.env.example 참고).
ITSM_MCP_URL=
ITSM_MCP_TOKEN=
