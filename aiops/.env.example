# 복사해서 .env로 사용합니다. 빈 비밀값(POSTGRES_PASSWORD 등)은 06-init-secrets.sh가 자동 생성합니다.
# .env 는 root:root 600 이며 git과 일반 백업에 넣지 않습니다.
TZ=Asia/Seoul
# 앱 이미지 태그 (aiops-api, aiops-jennifer-mcp). 스크립트와 compose가 모두 이 값을 씁니다.
APP_VERSION=0.3.3
INSTALL_ROOT=/opt/aiops
DATA_ROOT=/data
BACKUP_ROOT=/backup
# Docker 이미지·레이어 저장 경로 (09-docker-data-root.sh가 daemon.json에 설정)
DOCKER_DATA_ROOT=/data/docker

# 설치 단계: 127.0.0.1 (외부 미노출). 폐쇄망 전환 시 10.148.216.55 로 변경
WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
WEBUI_PORT=18081
API_PORT=18000
# 폐쇄망에서 18080/18081 에 접근할 수 있는 대역 (쉼표 구분). 17-docker-firewall.sh 가 DOCKER-USER 체인에 적용
# 비어 있으면 방화벽 규칙을 적용하지 않습니다 (O-21 현장 확인 후 입력). 예: 10.148.216.0/26,10.148.100.0/24
ALLOWED_CIDRS=

# online: 인터넷 허용 상태에서 이미지/패키지 다운로드·빌드. offline: 폐쇄망에서 로컬 자원만 사용
DEPLOY_MODE=online
# dev: apps/api/app 을 컨테이너에 마운트 (코드 수정 후 재시작만으로 반영). release: 이미지에 고정
IMAGE_MODE=dev
# 0: 인터넷 pip 사용 가능, 1: wheelhouse만 사용 (폐쇄망 빌드)
PIP_NO_INDEX=0

OLLAMA_IMAGE_TAG=0.12.6
PGVECTOR_IMAGE_TAG=pg16
CLICKHOUSE_IMAGE_TAG=24.8
REDIS_IMAGE_TAG=7.4-alpine
OPEN_WEBUI_TAG=v0.6.32
NGINX_IMAGE_TAG=1.28-alpine

POSTGRES_DB=aiops
POSTGRES_USER=aiops_app
POSTGRES_PASSWORD=
CLICKHOUSE_DB=aiops
CLICKHOUSE_USER=aiops_app
CLICKHOUSE_PASSWORD=
WEBUI_SECRET_KEY=

PRIMARY_MODEL=qwen3:14b
EMBEDDING_MODEL=bge-m3
CODER_MODEL=qwen2.5-coder:14b
DOWNLOAD_CODER_MODEL=true
OLLAMA_KEEP_ALIVE=30m
# 2: 생성 모델(qwen3:14b) + 임베딩(bge-m3)을 함께 올림. 1이면 임베딩 호출 때마다 qwen3가 내려갔다 다시 올라감.
#    두 생성 모델(qwen3 + coder)은 VRAM 16GB에 같이 안 들어가므로 Ollama가 자동으로 하나를 내립니다.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=2
# 기본 컨텍스트(4096)로는 분석 프롬프트(최대 16,000자)가 잘립니다. 병렬 2 × 16k 토큰 기준 VRAM 약 14~15GB.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_FLASH_ATTENTION=1
# KV 캐시 양자화(q8_0)로 VRAM 절약. 품질 문제가 보이면 f16 으로
OLLAMA_KV_CACHE_TYPE=q8_0

DATA_MODE=live
INSTITUTION_COUNT=30
BUSINESS_COUNT=140
INSTITUTION_COUNT_ESTIMATE=true
BUSINESS_COUNT_ESTIMATE=true
INSTITUTIONS_API_URL=
HISTORY_INCIDENTS_URL=
HISTORY_EVENTS_URL=
HISTORY_API_TOKEN=
HISTORY_INCIDENTS_TOKEN=
HISTORY_EVENTS_TOKEN=
HISTORY_API_TIMEOUT=15
HISTORY_POLL_SECONDS=300
# 같은 compose 네트워크의 jennifer-mcp 서비스. 비워 두면 API는 MCP를 호출하지 않습니다(설치 직후 꺼진 상태).
# 활성화 시: JENNIFER_MCP_URL=http://jennifer-mcp:8791/mcp
JENNIFER_MCP_URL=
# MCP 서버 인증 토큰. 06-init-secrets.sh 가 자동 생성 (jennifer-mcp 의 MCP_AUTH_TOKEN 으로도 전달됨)
JENNIFER_MCP_TOKEN=
JENNIFER_MCP_PROTOCOL_VERSION=2025-06-18
DIFY_BASE_URL=
DIFY_WORKFLOW_API_KEY=
DIFY_USER_LABEL=aiops-local
ANALYSIS_PROVIDER=ollama
OPEN_WEBUI_ENABLE_SIGNUP=false
# 폐쇄망에서 Open WebUI가 HuggingFace 에서 임베딩 모델을 받으려다 멈추지 않도록 Ollama의 bge-m3 를 사용
OPEN_WEBUI_RAG_EMBEDDING_ENGINE=ollama
OPEN_WEBUI_RAG_EMBEDDING_MODEL=bge-m3
LOG_LEVEL=INFO
