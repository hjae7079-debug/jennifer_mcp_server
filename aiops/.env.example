# 복사해서 .env로 사용합니다. 빈 비밀값(POSTGRES_PASSWORD 등)은 06-init-secrets.sh가 자동 생성합니다.
# .env 는 root:root 600 이며 git과 일반 백업에 넣지 않습니다.
TZ=Asia/Seoul
INSTALL_ROOT=/opt/aiops
DATA_ROOT=/data
BACKUP_ROOT=/backup
# Docker 이미지·레이어 저장 경로 (09-docker-data-root.sh가 daemon.json에 설정)
DOCKER_DATA_ROOT=/data/docker

# 설치 단계: 127.0.0.1 (외부 미노출). 폐쇄망 전환 시 10.148.216.55 로 변경
WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
WEBUI_PORT=18081
API_PORT=18000

# online: 인터넷 허용 상태에서 이미지/패키지 다운로드·빌드. offline: 폐쇄망에서 로컬 자원만 사용
DEPLOY_MODE=online
# dev: apps/api/app 을 컨테이너에 마운트 (코드 수정 후 재시작만으로 반영). release: 이미지에 고정
IMAGE_MODE=dev
# 0: 인터넷 pip 사용 가능, 1: wheelhouse만 사용 (폐쇄망 빌드)
PIP_NO_INDEX=0

OLLAMA_IMAGE_TAG=0.12.6
PGVECTOR_IMAGE_TAG=pg16
CLICKHOUSE_IMAGE_TAG=24.8
REDIS_IMAGE_TAG=7.4-alpine
OPEN_WEBUI_TAG=v0.6.32
NGINX_IMAGE_TAG=1.28-alpine

POSTGRES_DB=aiops
POSTGRES_USER=aiops_app
POSTGRES_PASSWORD=
CLICKHOUSE_DB=aiops
CLICKHOUSE_USER=aiops_app
CLICKHOUSE_PASSWORD=
WEBUI_SECRET_KEY=

PRIMARY_MODEL=qwen3:14b
EMBEDDING_MODEL=bge-m3
CODER_MODEL=qwen2.5-coder:14b
DOWNLOAD_CODER_MODEL=true
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2

DATA_MODE=live
INSTITUTION_COUNT=30
BUSINESS_COUNT=140
INSTITUTION_COUNT_ESTIMATE=true
BUSINESS_COUNT_ESTIMATE=true
INSTITUTIONS_API_URL=
HISTORY_INCIDENTS_URL=
HISTORY_EVENTS_URL=
HISTORY_API_TOKEN=
HISTORY_INCIDENTS_TOKEN=
HISTORY_EVENTS_TOKEN=
HISTORY_API_TIMEOUT=15
HISTORY_POLL_SECONDS=300
JENNIFER_MCP_URL=
JENNIFER_MCP_TOKEN=
JENNIFER_MCP_PROTOCOL_VERSION=2025-06-18
DIFY_BASE_URL=
DIFY_WORKFLOW_API_KEY=
DIFY_USER_LABEL=aiops-local
ANALYSIS_PROVIDER=ollama
OPEN_WEBUI_ENABLE_SIGNUP=false
LOG_LEVEL=INFO
